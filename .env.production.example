# =============================================================================
# AIbowler — production / Coolify environment (copy to host UI; never commit real secrets)
# =============================================================================
#
# This app uses PostgreSQL only (pg). It does NOT use Supabase.
#
# If you see: Missing NEXT_PUBLIC_SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY
# → Your server is running an OLD build (stale .next) and/or "next start" with
#   output: "standalone". Fix: deploy THIS repo, delete .next on the server,
#   run npm run build, then npm run start (see README). Do NOT add Supabase keys.
#
# =============================================================================

# --- App metadata (optional; not required by Next routes) ---
# APP_NAME=aibowler
# APP_ENV=production

# --- PostgreSQL (set DATABASE_URL OR the DB_* block) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aibowler
# Or:
# DB_HOST=
# DB_PORT=5432
# DB_NAME=aibowler
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false
# DB_SSLMODE=disable
# DB_CONNECT_TIMEOUT=10
# DB_POOL_SIZE=20

# --- Admin cookie session (required for /admin) ---
ADMIN_SESSION_SECRET=

# --- Public site URL (use your real domain in production) ---
NEXT_PUBLIC_APP_URL=https://aibowler.in

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
# RAZORPAY_KEY_ID: same as Key ID (rzp_live_... / rzp_test_...). Prefer this in Docker/Coolify
# so the server works even if NEXT_PUBLIC_* was not present at build time.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Twilio (optional: WhatsApp admin alert + optional customer SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ADMIN_NOTIFY_WHATSAPP_E164=
TWILIO_SMS_FROM=

# --- Resend (optional email) ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- NOT USED — do not add (would not fix the Supabase chunk error anyway) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
