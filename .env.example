# PostgreSQL — use DATABASE_URL or individual DB_* vars
# DATABASE_URL=postgresql://user:pass@localhost:5432/aibowler
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aibowler
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=20

# Admin session cookie (random string, 16+ chars)
ADMIN_SESSION_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/keys)
# Key ID is public; set RAZORPAY_KEY_ID so checkout works when env is only injected at runtime (e.g. Docker without build-args). Falls back to NEXT_PUBLIC_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio — admin WhatsApp + optional customer SMS (https://www.twilio.com/docs/whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# E.164, e.g. +919876543210 (join sandbox before messaging unknown numbers)
ADMIN_NOTIFY_WHATSAPP_E164=

# Optional: customer SMS confirmation (India +91 applied to 10-digit mobile)
TWILIO_SMS_FROM=

# Resend (optional; https://resend.com — use onboarding@resend.dev until your domain is verified)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Public site URL (optional). Use your production domain after deploy, e.g. https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
