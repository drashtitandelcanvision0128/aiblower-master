# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
# Use either anon key (legacy name) or publishable key from dashboard
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (https://dashboard.razorpay.com/app/keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio — admin WhatsApp + optional customer SMS (https://www.twilio.com/docs/whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# E.164, e.g. +919876543210 (join sandbox before messaging unknown numbers)
ADMIN_NOTIFY_WHATSAPP_E164=

# Optional: customer SMS confirmation (India +91 applied to 10-digit mobile)
TWILIO_SMS_FROM=

# Public site URL (optional). Use your production domain after deploy, e.g. https://yourdomain.com
# Helps future redirects/canonical URLs; booking flows work without it today.
NEXT_PUBLIC_APP_URL=http://localhost:3000
